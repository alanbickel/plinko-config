{
  "name": "plinko-config",
  "version": "0.0.0",
  "description": "Set user preferences by playing Plinko. A deliberately terrible UI component.",
  "keywords": [
    "plinko",
    "preferences",
    "settings",
    "ui",
    "joke",
    "web-component",
    "canvas"
  ],
  "homepage": "https://alanbickel.github.io/plinko-config/",
  "license": "MIT-0",
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size",
    "sim": "tsx scripts/simulate.ts",
    "test:e2e": "playwright test",
    "docs:dev": "npm --prefix site run dev",
    "docs:build": "npm --prefix site run build",
    "docs:examples": "tsc -p site/examples && tsc -p site/examples/recipes/html && tsc -p site/examples/recipes/react && tsc -p site/examples/recipes/solid && tsc -p site/examples/recipes/angular"
  },
  "size-limit": [
    {
      "name": "plinko-config",
      "path": "dist/index.js",
      "limit": "16 kB"
    },
    {
      "name": "plinko-config/element",
      "path": "dist/element.js",
      "limit": "17 kB"
    }
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^22.20.4",
    "jsdom": "^30.1.1",
    "size-limit": "^14.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
